rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role in ['super_admin', 'admin', 'content_manager', 'analyst', 'support']
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.super_admin == true ||
        request.auth.token.role == 'super_admin'
      );
    }

    function hasPermission(permissionName) {
      return isAdmin() && (
        isSuperAdmin() ||
        request.auth.token.permissions[permissionName] == true
      );
    }

    // ==========================================
    // ADMIN ONLY COLLECTIONS
    // ==========================================

    // Admin Users Directory - strictly Super Admin manage, Admins can read profile
    match /adminUsers/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // Admin Audit Logs - immutable audit trail
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable audit logs
    }

    // RAG Knowledge Sources & AI Pipeline Configuration
    match /ragKnowledgeSources/{docId} {
      allow read: if isAdmin();
      allow write: if hasPermission('ragManagement');
    }

    // System Configuration
    match /systemConfiguration/{configId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Question Repository - Players can read approved questions, only Admins with questionManagement can write
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if hasPermission('questionManagement');
    }

    // ==========================================
    // PLAYER COLLECTIONS
    // ==========================================

    // User Profile & Stats
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isSuperAdmin();
    }

    // Match History & Tournaments
    match /matchHistory/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
